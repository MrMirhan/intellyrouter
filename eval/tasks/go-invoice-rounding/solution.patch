+
 // Discount is a promotion applied to a whole invoice. Set either PercentBP or
 // Fixed.
 type Discount struct {
@@ -16,7 +21,7 @@
 	for _, n := range nets {
 		subtotal += n
 	}
-	if subtotal <= 0 || subtotal <= d.MinSubtotal {
+	if subtotal <= 0 || subtotal < d.MinSubtotal {
 		return out
 	}
 
@@ -27,8 +32,21 @@
 	}
 	if d.Fixed > 0 {
 		fixed := min(d.Fixed, subtotal)
+		remainders := make([]Cents, len(nets))
+		order := make([]int, len(nets))
+		var given Cents
 		for i, n := range nets {
 			out[i] = fixed * n / subtotal
+			remainders[i] = fixed * n % subtotal
+			given += out[i]
+			order[i] = i
+		}
+		slices.SortStableFunc(order, func(a, b int) int {
+			return cmp.Compare(remainders[b], remainders[a])
+		})
+		for k := 0; given < fixed; k++ {
+			out[order[k]]++
+			given++
 		}
 	}
 	return out
