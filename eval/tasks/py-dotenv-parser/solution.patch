+
+def _parse_value(value: str, lineno: int) -> str:
+    if value.startswith("'"):
+        end = value.find("'", 1)
+        if end == -1:
+            raise ParseError(lineno, "unterminated single quote")
+        _check_after_quote(value[end + 1:], lineno)
+        return value[1:end]
+
+    if value.startswith('"'):
+        out = []
+        i = 1
+        while i < len(value):
+            c = value[i]
+            if c == "\\" and value[i + 1:i + 2] in _ESCAPES:
+                out.append(_ESCAPES[value[i + 1]])
+                i += 2
+                continue
+            if c == '"':
+                _check_after_quote(value[i + 1:], lineno)
+                return "".join(out)
+            out.append(c)
+            i += 1
+        raise ParseError(lineno, "unterminated double quote")
+
+    m = _INLINE_COMMENT.search(value)
+    return value[:m.start()].rstrip() if m else value
+
+
+def _check_after_quote(rest: str, lineno: int) -> None:
+    rest = rest.strip()
+    if rest and not rest.startswith("#"):
+        raise ParseError(lineno, "unexpected text after closing quote")
 
 
