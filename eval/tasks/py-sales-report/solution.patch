+def _utc_month(timestamp: str) -> str:
+    placed_at = datetime.fromisoformat(timestamp)
+    if placed_at.utcoffset() is None:
+        raise ValueError(f"timestamp has no UTC offset: {timestamp!r}")
+    return placed_at.astimezone(timezone.utc).strftime("%Y-%m")
+
+
+def _round(value: Decimal, step: Decimal) -> str:
+    return str(value.quantize(step, rounding=ROUND_HALF_UP))
