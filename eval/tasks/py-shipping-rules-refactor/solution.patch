@@ -0,0 +1,62 @@
+"""Pricing rules. shipping.quote applies them in order to build a quote."""
+
+from decimal import ROUND_HALF_UP, Decimal
+
+CENT = Decimal("0.01")
+BASE_RATE = {1: Decimal("4.90"), 2: Decimal("9.90"), 3: Decimal("24.90")}
+PER_EXTRA_KG = {1: Decimal("0.50"), 2: Decimal("1.20"), 3: Decimal("4.00")}
+EXPRESS_MINIMUM_ZONE_3 = Decimal("15.00")
+DANGEROUS_GOODS_FEE = Decimal("12.00")
+VOLUME_DISCOUNT_THRESHOLD = Decimal("100.00")
+
+
+def _service(order: dict) -> str:
+    return order.get("service", "standard")
+
+
+class BaseRate:
+    name = "base"
+
+    def apply(self, order, quote):
+        quote.add(self.name, BASE_RATE[quote.zone] + PER_EXTRA_KG[quote.zone] * (quote.kg - 1))
+
+
+class Express:
+    name = "express"
+
+    def apply(self, order, quote):
+        if _service(order) != "express":
+            return
+        extra = (quote.total * Decimal("0.5")).quantize(CENT, rounding=ROUND_HALF_UP)
+        if quote.zone == 3:
+            extra = max(extra, EXPRESS_MINIMUM_ZONE_3)
+        quote.add(self.name, extra)
+
+
+class DangerousGoods:
+    name = "dangerous_goods"
+
+    def apply(self, order, quote):
+        if not any(item.get("dangerous", False) for item in order["items"]):
+            return
+        if quote.zone == 3:
+            raise ValueError("dangerous goods cannot be shipped to zone 3")
+        quote.add(self.name, DANGEROUS_GOODS_FEE)
+
+
+class Coupon:
+    name = "coupon"
+
+    def apply(self, order, quote):
+        if order.get("coupon") == "FREESHIP" and quote.zone == 1 and _service(order) == "standard":
+            quote.add(self.name, -quote.total)
+
+
+class VolumeDiscount:
+    name = "volume_discount"
+
+    def apply(self, order, quote):
+        cost = quote.total
+        if cost > 0 and quote.subtotal >= VOLUME_DISCOUNT_THRESHOLD and quote.zone != 3:
+            discount = (cost * Decimal("0.2")).quantize(CENT, rounding=ROUND_HALF_UP)
+            quote.add(self.name, -discount)
